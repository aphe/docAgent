{
  "name": "docAgent",
  "version": "0.1.0",
  "description": "A VoltAgent application",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env ./src",
    "build": "tsdown",
    "start": "node dist/index.js",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "typecheck": "tsc --noEmit",
    "volt": "volt"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@voltagent/cli": "^0.1.10",
    "@voltagent/core": "^2.0.0",
    "@voltagent/libsql": "^2.0.0",
    "@voltagent/logger": "^2.0.0",
    "@voltagent/server-hono": "^2.0.0",
    "ai": "^6.0.0",
    "dotenv": "^16.4.7",
    "pdfjs-dist": "^4.10.38",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cantoo/pdf-lib": "^2.11.1",
    "@types/node": "^22.10.5",
    "hono": "4.13.16",
    "tsdown": "^0.15.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}